APP_ENV=development
HTTP_PORT=8080
# Comma-separated; "*" is fine for local dev, lock down for real deployments.
CORS_ALLOWED_ORIGINS=*

DB_HOST=localhost
DB_PORT=5432
DB_USER=pegasus
DB_PASSWORD=pegasus
DB_NAME=pegasus
DB_SSLMODE=disable

JWT_ACCESS_SECRET=dev-access-secret-change-me
REFRESH_TOKEN_PEPPER=dev-refresh-pepper-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

OTP_TTL=5m
OTP_COOLDOWN=60s
OTP_MAX_ATTEMPTS=5

# Local-disk dev storage for uploaded washing-point photos (see
# internal/platform/storage.LocalDisk) — not multi-instance safe, swap for
# an S3/GCS implementation before scaling past one API instance.
UPLOADS_DIR=./uploads
UPLOADS_BASE_URL=/uploads

# Firebase Cloud Messaging (push notifications). Leave empty to disable push
# (a no-op sender logs instead). Provide the service-account key inline OR as
# a file path — never commit it.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
# FCM_SERVICE_ACCOUNT_JSON=

# Production (APP_ENV=production) refuses to start with the dev defaults for
# JWT_ACCESS_SECRET / REFRESH_TOKEN_PEPPER or with secrets shorter than 32
# characters — generate real ones, e.g. `openssl rand -hex 32`.

# SMS provider for customer login OTPs. "stub" (default) only logs the code to
# stdout; "payom" sends through Payom.tj and fails at startup if the values
# below are missing. Only +992 numbers are accepted. Booking notifications
# always use the logging stub. PAYOM_BASE_URL and PAYOM_API_TOKEN are issued in
# the Payom dashboard after registration -- never commit the token.
SMS_PROVIDER=stub
PAYOM_BASE_URL=
PAYOM_API_TOKEN=
# Up to 11 Latin letters, digits or dots; may need pre-registration with Payom.
PAYOM_SENDER_NAME=QWash
# Individual (non-legal-entity) accounts can only send by template: set the
# template's UUID here; it must use a {code} variable. Empty = free text
# (legal entities only).
PAYOM_OTP_TEMPLATE_ID=

# Sentry error monitoring. Leave empty to disable; only ever active when
# APP_ENV=production regardless (see internal/platform/monitoring).
SENTRY_DSN=
