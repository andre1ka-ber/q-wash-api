APP_ENV=development
HTTP_PORT=8080
# Comma-separated; "*" is fine for local dev, lock down for real deployments.
CORS_ALLOWED_ORIGINS=*

DB_HOST=localhost
DB_PORT=5432
DB_USER=pegasus
DB_PASSWORD=pegasus
DB_NAME=pegasus
DB_SSLMODE=disable

JWT_ACCESS_SECRET=dev-access-secret-change-me
REFRESH_TOKEN_PEPPER=dev-refresh-pepper-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h

OTP_TTL=5m
OTP_COOLDOWN=60s
OTP_MAX_ATTEMPTS=5

# Local-disk dev storage for uploaded washing-point photos (see
# internal/platform/storage.LocalDisk) — not multi-instance safe, swap for
# an S3/GCS implementation before scaling past one API instance.
UPLOADS_DIR=./uploads
UPLOADS_BASE_URL=/uploads

# Firebase Cloud Messaging (push notifications). Leave empty to disable push
# (a no-op sender logs instead). Provide the service-account key inline OR as
# a file path — never commit it.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
# FCM_SERVICE_ACCOUNT_JSON=
